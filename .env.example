# 이 파일을 복사해 .env를 만들고 값을 채웁니다. (cp .env.example .env)
# .env가 없으면 빌드·테스트가 실패하므로 값이 없어도 파일은 만들어 둡니다.
# .env는 git에 올리지 않습니다. 앱 안에 그대로 들어가므로 비밀키는 적지 않습니다.

# 차곡 API 서버 주소. 포트와 /api/v1까지 적고, 끝에 /를 붙이지 않습니다.
# 예: http://<호스트>:8080/api/v1
# 비워 두면 서버 없이 예시 데이터로 돕니다.
API_BASE_URL=

# 서버 주소가 http://일 때만 true로 바꿉니다. release 빌드에서는 무시됩니다.
ALLOW_INSECURE_HTTP=false

# 카카오 로그인용 네이티브 앱 키 (Kakao Developers → 앱 → 앱 키).
# REST API 키·Admin 키는 넣지 않습니다. 비워 두면 카카오 로그인이 동작하지 않습니다.
KAKAO_NATIVE_APP_KEY=
